{
  "name": "@timodesk/spine",
  "version": "0.1.0",
  "description": "Timo Reception Robot — Integration Spine (WebSocket gateway, SDK interface, safety interlocks)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
