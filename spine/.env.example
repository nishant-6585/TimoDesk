# ============================================================================
# Minee Spine Configuration
# ============================================================================
# Copy this to .env and fill in your values
# DO NOT commit .env — it contains secrets
# ============================================================================

# Robot IP — the spine connects to this robot on boot.
ROBOT_IP=192.168.99.101

# ============================================================================
# Voice brain — KB retrieval (Voyage embeddings) + Claude RAG (T5/T6/T7)
# ============================================================================
# Voyage AI API key — embeds KB chunks + questions (voyage-3.5, 1024-dim).
# Without it, /ask and KB search are unavailable. Optional model override.
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxx
# VOYAGE_MODEL=voyage-3.5
# Anthropic API key — grounded spoken answers on KB miss (claude-opus-4-8).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# CLAUDE_MODEL=claude-opus-4-8
# KB auto-sync — when set (any value), the spine periodically re-crawls/re-ingests
# managed KB sources (admin → Knowledge Base → auto-sync toggle per source) so
# URL/crawl content stays fresh. Unset = off (manual "Sync now" still works). The
# scheduler polls every 30 min; each source's own interval decides if it's due.
# KB_AUTOSYNC=1

# Spine server port
SPINE_PORT=4000

# ============================================================================
# Supabase Integration (optional for dev, required for production)
# ============================================================================

# Used for the supabase client AND for JWKS auth (verifying ES256 user tokens
# against {SUPABASE_URL}/auth/v1/.well-known/jwks.json). Leave empty to skip
# Supabase; spine runs but events won't persist and JWKS auth is unavailable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# ============================================================================
# Authentication (optional for dev, required for production)
# ============================================================================

# Auth verifies Supabase user access tokens (ES256) via the project JWKS — no
# shared secret needed. SUPABASE_URL above is what enables it. (The legacy HS256
# JWT_SECRET is no longer used.)

# DEV AUTH BYPASS — local development only. When set to 1 (and NODE_ENV is NOT
# 'production'), spine accepts `Authorization: Bearer test-token` (or a missing
# token) as a 'dev-user', and accepts the WebSocket without a real JWT. This lets
# the joystick + enrollment work without logging in.
#   - Unset / not '1'  → FAIL-CLOSED: every request needs a real verified JWT.
#   - NODE_ENV=production → bypass is ALWAYS off, even if this is 1.
# NEVER set this in production.
DEV_AUTH_BYPASS=1

# KIOSK_TOKEN — static shared secret for the robot chest-screen (robot_app). The
# kiosk has no Supabase session, so it can't present an ES256 user token; instead
# it sends this secret over the WS + HTTP and is authorized as 'kiosk-robot'. This
# is honored in PRODUCTION too (not gated by DEV_AUTH_BYPASS), so it's the
# supported kiosk auth path (auth go-live item #5). Use a long random string and
# set the SAME value in robot_app → Settings → kiosk token. Leave empty to disable
# (then the kiosk only works under DEV_AUTH_BYPASS). Tradeoff: long-lived static
# credential — rotate manually.
KIOSK_TOKEN=

# ============================================================================
# Safety Interlocks (optional)
# ============================================================================

# Set to "true" to disable chassis movement during office hours
# Default: false (movement allowed at all times)
OFFICE_HOURS_MODE=false

# ============================================================================
# Host notifications (#70 — visitor arrival → notify host staff)
# notify_channel format: "slack:U0ABC", "whatsapp:+9198...", "email:a@b.com"
# ============================================================================
# Slack Incoming Webhook URL (for slack: channels)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Interakt API key (Basic auth) for WhatsApp (for whatsapp: channels)
INTERAKT_API_KEY=your-interakt-api-key
# Resend API key + verified From address for email (for email: channels).
# If unset, email notifications are log-only (dev). Set both to actually send.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
NOTIFY_EMAIL_FROM=Timo Reception <reception@xboom.in>

# Where to page a HUMAN when the robot can't answer a visitor and promised one
# (F5 handoff). Same "prefix:value" format as a staff notify_channel. Unset =
# handoffs are logged only, and nobody is paged.
HANDOFF_NOTIFY_CHANNEL=slack:U0FRONTDESK

# ============================================================================
# F1 — visitor arrival snapshot
# ============================================================================
# "true" attaches a plain arrival photo to the visitor row (visitor.snapshot_url),
# purged with the row at 30 days. NEVER a biometric: it is not embedded, not
# matched, and never reaches staff_face_embedding. OFF by default — turn it on
# only once the reception DPDP notice is posted.
ARRIVAL_SNAPSHOT_ENABLED=false

# ============================================================================
# F9 — after-hours security patrol + intrusion alarm
# ============================================================================
# Local-time window in which the robot patrols autonomously, "HH:MM-HH:MM".
# May wrap midnight (the normal case). UNSET = the scheduler is OFF and the
# robot never starts driving on its own — leave it unset unless you mean it.
# The route is every saved nav point of kind 'navigation', in sort_order.
AFTER_HOURS_PATROL_WINDOW=19:00-06:00
# Where intrusion alerts go. Falls back to HANDOFF_NOTIFY_CHANNEL when unset.
SECURITY_NOTIFY_CHANNEL=slack:U0SECURITY

# ============================================================================
# F8 — guided office tour
# ============================================================================
# How long the robot waits for questions at each tour station, milliseconds.
TOUR_QUESTION_WINDOW_MS=20000

# ============================================================================
# Push notifications (#90 — FCM HTTP v1 → mobile admin app)
# If unset, push is simply disabled (no-op). NOT committed — service account is
# a secret. Get these from the Firebase console (Project settings → Service
# accounts → Generate new private key).
# ============================================================================
# Service account: either an inline JSON string OR a path to the key file.
# (GOOGLE_APPLICATION_CREDENTIALS, a file path, is also honored.)
FCM_SERVICE_ACCOUNT=/absolute/path/to/firebase-service-account.json
# FCM project id (also read from the service-account JSON's project_id field).
FCM_PROJECT_ID=your-firebase-project-id

# ============================================================================
# KB platform + ElevenLabs grounding (two-brains fix, HANDOFF option B)
# ============================================================================
# Shared secret for the ElevenLabs server-tool webhook (POST /elevenlabs/ask).
# Configure the same value in the ElevenLabs agent's webhook tool as the
# `x-tool-secret` header. Unset = the endpoint refuses every call (fail-closed).
ELEVENLABS_TOOL_SECRET=choose-a-long-random-string

# ============================================================================
# XBoom Workflow OS — showroom Order/Enquiry capture (POST /xboom/lead)
# The face screen's Order + Enquiry FABs post visitor leads here; the spine
# signs them (HMAC-SHA256, x-xbm-signature) and forwards to the
# robot-lead-incoming edge function in the XBOOM WORKFLOW project (NOT the
# spine's own Supabase above) → enquiries table, lead_source 'walk_in'.
# Secret must equal ROBOT_WEBHOOK_SECRET in that project's function secrets.
# Unset = /xboom/lead returns 503 (feature off).
# ============================================================================
XBOOM_LEAD_ENDPOINT=https://xboom-workflow-ref.supabase.co/functions/v1/robot-lead-incoming
XBOOM_WEBHOOK_SECRET=choose-a-long-random-string
# Optional — robot-catalog function URL for the kiosk product browser
# (GET /xboom/catalog). Defaults to XBOOM_LEAD_ENDPOINT with the last path
# segment swapped to robot-catalog, so usually leave unset.
# XBOOM_CATALOG_ENDPOINT=https://xboom-workflow-ref.supabase.co/functions/v1/robot-catalog

# ============================================================================
# Microsoft Entra ID (Azure AD) staff directory sync (POST /entra/sync)
# App registration with Application permission User.Read.All (admin consent).
# Unset = /entra/sync returns 503 (feature off).
# ============================================================================
ENTRA_TENANT_ID=your-tenant-guid
ENTRA_CLIENT_ID=your-app-registration-client-id
ENTRA_CLIENT_SECRET=your-client-secret
