<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <!-- All-files access — matches the vendor demo. The CSJBot SDK reads the robot's
         own AIUI key from /sdcard/.robot_info/aiuikey.txt; Android-14 scoped storage
         blocks plain READ_EXTERNAL_STORAGE for non-media files, causing InvalidAppId
         (no ASR). Granted at runtime via Settings → All files access (or appops). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Auto-bring-up after reboot (BootReceiver): free the mic (Option B) + launch. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:label="Mikee"
        android:name=".MikeeApplication"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="sensorLandscape"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- HOME + DEFAULT: Mikee can be the launcher/home so it owns the
                     Home button and auto-starts on boot (kiosk). Set as default via
                     `cmd package set-home-activity` or by the device-owner. -->
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <meta-data
            android:name="CSJ_SDK_REMOTE_APP_NAME"
            android:value="${applicationId}" />
        <!-- Kiosk device-admin — enables `dpm set-device-owner` for Lock Task Mode. -->
        <receiver
            android:name=".KioskAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Auto-bring-up after reboot: free the mic (Option B) + launch Mikee. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <package android:name="com.google.android.tts" />
        <package android:name="com.android.tts" />
        <package android:name="com.csjbot.robotsdk.ten" />
        <!-- Matches the vendor demo's manifest (Android-11+ service visibility). -->
        <intent>
            <action android:name="com.csjbot.robotsdkservice.startservice" />
        </intent>
    </queries>
</manifest>
