# ============================================================================
# Timo Spine Configuration
# ============================================================================
# Copy this to .env and fill in your values
# DO NOT commit .env — it contains secrets
# ============================================================================

# Robot SDK Mode
# Options: "mock" (for development), "real" (for production)
ROBOT_MODE=mock

# Robot IP (only used if ROBOT_MODE=real)
ROBOT_IP=192.168.99.101

# Spine server port
SPINE_PORT=4000

# ============================================================================
# Supabase Integration (optional for dev, required for production)
# ============================================================================

# Leave empty to skip Supabase; spine will run but events won't persist
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# ============================================================================
# Authentication (optional for dev, required for production)
# ============================================================================

# Leave empty to disable auth (dev mode only)
# Set to your JWT secret to enable auth
JWT_SECRET=your-jwt-secret-from-supabase-auth-settings

# ============================================================================
# Safety Interlocks (optional)
# ============================================================================

# Set to "true" to disable chassis movement during office hours
# Default: false (movement allowed at all times)
OFFICE_HOURS_MODE=false
